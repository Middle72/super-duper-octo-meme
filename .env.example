# Which eBay environment to talk to: "SANDBOX" or "PRODUCTION"
EBAY_ENV=SANDBOX

# From your eBay developer account (developer.ebay.com -> My Account -> Application Keys)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# User access token flow: generate a refresh token once via eBay's "User Access Token"
# tool (developer.ebay.com/my/auth/) using the sell.inventory scope, then paste it here.
# The app exchanges this for short-lived access tokens automatically.
EBAY_REFRESH_TOKEN=

# eBay marketplace this account sells on, e.g. EBAY_US, EBAY_GB, EBAY_DE
EBAY_MARKETPLACE_ID=EBAY_US

# A merchant location key identifying where inventory ships from (created once with
# `ebay-seller create-location`, then reused for every listing).
EBAY_MERCHANT_LOCATION_KEY=
